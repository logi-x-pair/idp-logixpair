{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**"],
			// Turbo 2 strict env mode strips undeclared variables from task
			// environments (locally masked by dotenv reading .env off disk).
			// Declare every var the env schema (packages/env/src/server.ts)
			// consumes so CI/builds receive them and they hash the cache.
			"env": [
				"DATABASE_URL",
				"BETTER_AUTH_SECRET",
				"BETTER_AUTH_URL",
				"CORS_ORIGIN",
				"REQUIRE_EMAIL_VERIFICATION",
				"TWO_FACTOR_ENABLED",
				"RATE_LIMIT_STORAGE",
				"TRUSTED_PROXIES",
				"OAUTH_*",
				"IDP_ADMIN_*",
				"MAILER_*",
				"SKIP_ENV_VALIDATION"
			]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"db:push": {
			"cache": false
		},
		"db:generate": {
			"cache": false
		},
		"db:migrate": {
			"cache": false,
			"persistent": true
		},
		"db:baseline": {
			"cache": false
		},
		"db:studio": {
			"cache": false,
			"persistent": true
		},
		"db:start": {
			"cache": false,
			"persistent": true
		},
		"db:stop": {
			"cache": false
		},
		"db:watch": {
			"cache": false,
			"persistent": true
		},
		"db:down": {
			"cache": false
		}
	}
}
