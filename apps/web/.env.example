# ============================================================================
# Per-brand deployment configuration.
# Every brand deployment supplies its own copy of this file as `.env`.
# See NEW_BRAND.md for the full deployment checklist.
# ============================================================================

# PostgreSQL connection string for this brand's database.
# Local dev via Docker (packages/db/docker-compose.yml) listens on host port 5433.
DATABASE_URL=postgresql://postgres:password@localhost:5433/krazil-idp

# Secret used by Better Auth for signing/encryption. Generate with:
#   openssl rand -base64 32
# Minimum 32 characters. NEVER commit the real value.
BETTER_AUTH_SECRET=

# The per-brand issuer URL, e.g. https://auth.<brand-domain>.com
# Local development: http://localhost:3000
# The OAuth/OIDC issuer is `${BETTER_AUTH_URL}/api/auth`.
BETTER_AUTH_URL=http://localhost:3000

# Allowed CORS origin (same-origin fullstack app: usually equals BETTER_AUTH_URL).
CORS_ORIGIN=http://localhost:3000

# Local-dev-only test user created by `bun run seed:user` (never set in
# production). Password must be at least 8 characters.
SEED_USER_NAME=Test User
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# ----------------------------------------------------------------------------
# OAuth 2.1 provider settings (Phase 2+)
# ----------------------------------------------------------------------------

# Comma-separated list of valid audiences (resource servers) for JWT access
# tokens, e.g. https://api.<brand-domain>.com. Empty = issuer base URL only.
OAUTH_VALID_AUDIENCES=

# Token prefixes for secret-scanner compatibility. Set BEFORE the first
# production deploy; IMMUTABLE afterwards (see RUNBOOK.md).
OAUTH_ACCESS_TOKEN_PREFIX=
OAUTH_REFRESH_TOKEN_PREFIX=
OAUTH_CLIENT_SECRET_PREFIX=

# Pairwise subject identifiers (OIDC subject_type=pairwise). Leave empty for
# the default public subject type (sub = internal user id). If set: >=32 chars
# and PERMANENT once set — rotating it breaks all pairwise RP sessions.
# OAUTH_PAIRWISE_SECRET=
