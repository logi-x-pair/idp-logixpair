# ============================================================================
# Per-brand deployment configuration.
# Every brand deployment supplies its own copy of this file as `.env`.
# See NEW_BRAND.md for the full deployment checklist.
# ============================================================================

# Local dev via Docker (packages/db/docker-compose.yml) listens on host port 5433.
# POSTGRES_PASSWORD is supplied to Compose from untracked packages/db/.env or
# the shell; this URL placeholder is not a usable credential.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5433/krazil-idp

# Secret used by Better Auth for signing/encryption. Generate with:
#   openssl rand -base64 32
# Minimum 32 characters. NEVER commit the real value.
BETTER_AUTH_SECRET=

# The per-brand issuer URL, e.g. https://auth.<brand-domain>.com
# Local development: http://localhost:3000
# The OAuth/OIDC issuer is `${BETTER_AUTH_URL}/api/auth`.
BETTER_AUTH_URL=http://localhost:3000

# Allowed CORS origin (same-origin fullstack app: usually equals BETTER_AUTH_URL).
CORS_ORIGIN=http://localhost:3000

# Verification emails are always sent on sign-up. Set true to block password
# sign-in until the address is verified; false preserves the template demo flow.
REQUIRE_EMAIL_VERIFICATION=false

# Exposes user opt-in TOTP enrollment controls. The 2FA plugin remains mounted
# when false so accounts enrolled earlier are never allowed to bypass 2FA.
TWO_FACTOR_ENABLED=false

# Local-dev-only test user created by `bun run seed:user` (never set in
# production). Password must be at least 12 characters.
SEED_USER_NAME=Test User
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# Operator admin used by `bun run seed:clients` and `bun run clients` (created
# on first use). Must be listed in OAUTH_ADMIN_EMAILS; use a 12+ character password.
IDP_ADMIN_EMAIL=
IDP_ADMIN_PASSWORD=

# Production transactional email delivery. The endpoint receives JSON
# {to, subject, html, text}; token is optional bearer authentication. Leave
# empty only for development, where the console mailer is used.
MAILER_WEBHOOK_URL=
MAILER_WEBHOOK_TOKEN=

# Disposable protocol-test database only. Both values are REQUIRED by
# `bun run test`; never point them at development/staging/production.
TEST_DATABASE_ADMIN_URL=
TEST_DATABASE_URL=

# ----------------------------------------------------------------------------
# OAuth 2.1 provider settings (Phase 2+)
# ----------------------------------------------------------------------------

# Comma-separated list of valid audiences (resource servers) for JWT access
# tokens, e.g. https://api.<brand-domain>.com. Empty = issuer base URL only.
OAUTH_VALID_AUDIENCES=

# Access-token authorization mode. All modes retain JWT issuance so existing
# clients and JWKS discovery remain compatible:
#   short-lived = local JWT verification; rely on exp (default 1h).
#   hybrid = local verification plus live sid/sub status on high-risk routes.
#   immediate = live sid/sub status on every protected resource route.
OAUTH_ACCESS_TOKEN_MODE=short-lived

# Required for hybrid/immediate resource-server status checks. Generate a
# random 32+ character value and share it only with trusted resource servers.
OAUTH_REVOCATION_CHECK_SECRET=

# Comma-separated emails allowed to manage OAuth clients (create/rotate/etc).
OAUTH_ADMIN_EMAILS=

# Comma-separated client_ids to cache in memory as locked trusted clients.
# Printed by `bun run seed:clients`. Cached clients cannot be rotated or
# disabled without removing them from this list and restarting (RUNBOOK.md).
OAUTH_TRUSTED_CLIENT_IDS=

# Token prefixes for secret-scanner compatibility. Set BEFORE the first
# production deploy; IMMUTABLE afterwards (see RUNBOOK.md).
OAUTH_ACCESS_TOKEN_PREFIX=
OAUTH_REFRESH_TOKEN_PREFIX=
OAUTH_CLIENT_SECRET_PREFIX=

# Pairwise subject identifiers (OIDC subject_type=pairwise). Leave empty for
# the default public subject type (sub = internal user id). If set: >=32 chars
# and PERMANENT once set — rotating it breaks all pairwise RP sessions.
# OAUTH_PAIRWISE_SECRET=
