# Run one RP instance at a time with its own port and credentials.
RP_PORT=4101
RP_NAME=Test RP One
RP_CLIENT_ID=
RP_CLIENT_SECRET=
OIDC_ISSUER=http://localhost:3000/api/auth
RP_REDIRECT_URI=http://localhost:4101/callback
RP_POST_LOGOUT_URI=http://localhost:4101/

# Optional local callback used only by the two-RP E2E harness. Standard
# OIDC end-session clears the IdP session, not another RP's local cookie.
RP_PEER_LOGOUT_URL=

# Dedicated local test account — never real credentials.
TEST_RP_USER_EMAIL=
TEST_RP_USER_PASSWORD=

# Credentials printed once by `bun --cwd apps/web run seed:clients` for the
# Test RP One and Test RP Two entries in branding/clients.ts. Store only in
# this untracked file for localhost E2E.
E2E_RP1_CLIENT_ID=
E2E_RP1_CLIENT_SECRET=
E2E_RP2_CLIENT_ID=
E2E_RP2_CLIENT_SECRET=
TEST_RP_USER_NAME=E2E Test User
